# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database ──────────────────────────────────────────────────
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/careerpilot?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string

# ── AI (Groq) ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here

# ── Firebase (client-side, exposed to browser via Vite) ───────
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
